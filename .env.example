# MetaComp FX Rate Hub -- environment
#
# Copy to .env.local and fill in. .env.local is gitignored.
#
# This repository is public. NOTHING in this file may carry a real value --
# not the project ref, not the publishable key, not a partner name, not a real
# rate book. Placeholders only. See docs/spec-findings.md F5.

# --- Safe to expose in a browser bundle ------------------------------------
# Supabase dashboard -> Project Settings -> API
#
# The NEXT_PUBLIC_ prefix is what puts these in the client bundle, which is
# correct for these two and MUST NOT be added to anything below.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_<...>

# Absolute origin, used to build the magic-link redirect when the request
# carries no Origin header. On Vercel, set this to the deployment URL.
NEXT_PUBLIC_SITE_URL=https://<your-deployment>.vercel.app

# --- SECRETS. Never commit. Never prefix with NEXT_PUBLIC_. -----------------
# §12.3: "The service-role key is used only in server-side routes and MUST NOT
# appear in any browser bundle." `npm run build` runs
# scripts/assert-no-service-key.mjs, which fails the build if it ever does --
# including on Vercel, on every deploy.
#
# Supabase dashboard -> Project Settings -> API -> service_role
SUPABASE_SERVICE_ROLE_KEY=

# --- Local development and CI only. Not needed by the deployed app. ---------
# Direct Postgres connection, used by the migration runner and by the schema
# assertions T24-T26, which read pg_catalog and cannot go through PostgREST.
# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<host>:6543/postgres
