# MetaComp FX Rate Hub -- environment
#
# Copy to .env.local and fill in. .env.local is gitignored.
#
# This repository is public. NOTHING in this file may carry a real value --
# not the project ref, not the publishable key, not a partner name, not a real
# rate book. Placeholders only. See docs/spec-findings.md F5.

# --- Safe to expose in a browser bundle ------------------------------------
# Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=sb_publishable_<...>

# --- SECRETS. Never commit. Never import into client code. -----------------
# §12.3: "The service-role key is used only in server-side routes and MUST NOT
# appear in any browser bundle." scripts/assert-no-service-key.mjs fails the
# build if it ever does.
#
# Supabase dashboard -> Project Settings -> API -> service_role
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, used by the migration runner and by the schema
# assertions T24-T26 (which must read pg_catalog and cannot go through PostgREST).
# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<host>:6543/postgres
