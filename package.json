{
  "name": "metacomp-rate-hub",
  "version": "0.1.0",
  "private": true,
  "description": "MetaComp FX Rate Hub - internal partner rate board with an indicative quote. Built to rate-hub-spec-v2-1.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/assert-no-service-key.mjs && node scripts/assert-no-float-arithmetic.mjs && node scripts/assert-no-rate-logging.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "db:push": "node scripts/apply-migrations.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:schema": "vitest run tests/schema",
    "test:access": "vitest run tests/access",
    "typecheck": "tsc --noEmit",
    "a11y": "node scripts/a11y-scan.mjs && node scripts/contrast-check.mjs",
    "lint:decimals": "node scripts/assert-no-float-arithmetic.mjs",
    "test:degraded": "vitest run tests/degraded",
    "db:verify-rebuild": "node scripts/verify-rebuild.mjs",
    "lint:logs": "node scripts/assert-no-rate-logging.mjs",
    "backup": "node scripts/backup.mjs",
    "backup:verify": "node scripts/backup.mjs --verify"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10",
    "decimal.js": "^10.4.3",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "axe-core": "^4.13.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.24",
    "jsdom": "^30.0.1",
    "pg": "^8.13.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "postcss": "^8.5.26"
  }
}
